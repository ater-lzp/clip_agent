# Runtime
CLIP_ENV=development
CLIP_HOST=127.0.0.1
CLIP_PORT=8000
CLIP_DATABASE_PATH=./data/clip_agent.sqlite3
CLIP_CHECKPOINT_PATH=./data/checkpoints.sqlite3
CLIP_MEDIA_ROOT=./data/media
CLIP_SESSION_TTL_HOURS=168
CLIP_COOKIE_SECURE=false
CLIP_ALLOWED_ORIGINS=http://localhost:5173
CLIP_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# real is the normal runtime. fake must be selected explicitly for automated tests
# and never sends LLM, MiMo TTS, or Pexels requests.
CLIP_PROVIDER_MODE=real
CLIP_PROVIDER_MAX_RETRIES=2
CLIP_MAX_DOWNLOAD_BYTES=52428800

# OpenAI-compatible structured-output chat endpoint (required in real mode)
LLM_BASE_URL=
LLM_API_KEY=
LLM_NAME=
LLM_TIMEOUT_SECONDS=120

# Xiaomi MiMo chat-completions TTS endpoint (required in real mode).
# Set the base ending in /v1; the adapter appends chat/completions.
TTS_BASE_URL=
TTS_API_KEY=
TTS_NAME=
TTS_TIMEOUT_SECONDS=90

# Pexels API (required in real mode)
PEXELS_BASE_URL=
PEXELS_API_KEY=
PEXELS_MAX_QUERIES=6
PEXELS_PER_PAGE=15
PEXELS_TIMEOUT_SECONDS=20

# Optional local directory containing licensed .wav/.mp3 BGM files.
BGM_LIBRARY_DIR=
